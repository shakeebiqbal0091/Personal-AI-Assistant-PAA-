# Required: replace these placeholders in your local, ignored .env file.
AI_API_KEY=your_openrouter_api_key
AI_MODEL=your_selected_model_id

# Optional. Defaults to https://openrouter.ai/api/v1.
AI_BASE_URL=https://openrouter.ai/api/v1

# Optional application settings.
APP_NAME=Personal AI Assistant
DEBUG=False
USER_TZ=UTC
